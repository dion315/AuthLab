# Copy to .env and edit. Only bootstrap settings live here — identity provider
# configuration, role mapping, and SCIM tokens are managed in the admin console
# at runtime, not in this file.

# --- required ----------------------------------------------------------------

# Signs session cookies and derives the key that encrypts stored IdP secrets.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it signs everyone out and makes stored IdP secrets unreadable.
APP_SECRET_KEY=

# The externally visible URL of this app. Redirect URIs, SAML ACS URLs, and the
# SCIM tenant URL are all derived from it, and the session cookie's Secure flag
# is set when this is https. Getting it wrong is the most common cause of
# redirect-URI mismatch errors.
BASE_URL=http://localhost:8000

# --- optional ----------------------------------------------------------------

PORT=8000
LOG_LEVEL=info

# SQLite by default — no database service required.
# Postgres:  postgresql+psycopg://user:password@host:5432/authlab
DATABASE_URL=sqlite:///./data/authlab.db

SESSION_TTL_MINUTES=60

# Honour X-Forwarded-For / X-Forwarded-Proto. Required behind any cloud load
# balancer, otherwise every sign-in is recorded with the balancer's IP — which
# matters because source IP is a Conditional Access condition. Turn it off only
# if the app is directly internet-facing with nothing in front of it.
TRUST_PROXY_HEADERS=true

# The local administrator. This is the account that still works when a
# Conditional Access policy blocks federated sign-in, so it is deliberately
# easy to recover.
#
# Set BOOTSTRAP_ADMIN_PASSWORD and it *is* the password: it is applied on every
# start, so editing it here and restarting is a supported way back in. It is
# never written to the log — it already lives in this file.
#
# Leave it blank and the app generates a password instead, then reissues and
# prints it in a banner on every start, so missing it in a wall of container
# output costs a restart rather than the account. That does mean the password
# is in the log, which is the reason to set one here for anything long-lived.
#
# Either way, changing the password in the admin console takes ownership of it:
# startup then leaves it alone until you set a value here again.
BOOTSTRAP_ADMIN_EMAIL=admin@authlab.local
BOOTSTRAP_ADMIN_PASSWORD=
